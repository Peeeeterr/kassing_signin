!PhotoStorage/*.txt

PhotoStore/*
!PhotoStore/.gitkeep
!PhotoStore/*.txt

inputs/*
!inputs/.gitkeep

Archives/*
!Archives/.gitkeep

outputs/*
!outputs/.gitkeep

