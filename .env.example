# ==============================================================================
# 学搭子 (kassing.cn) 智能打卡配置文件模版 (.env.example)
# 初次使用请执行: ./run.sh (Linux) 或 run.bat (Windows) 进行向导式初始化
# ==============================================================================

# a. 登录用户名 (工号 / 学号)
ACCOUNT=

# b. 登录密码
PASSWORD=

# c. 距离总部的随机距离范围 (单位: 米)
#    定位坐标将在以总部为中心、该数值为半径的圆形区域内极坐标均匀随机分布。
#    总部打卡允许有效半径为 300 米，建议设置在 20 ~ 150 米之间。
DISTANCE_RANGE_METERS=50

# d. 照片冷却期次数 (单位: 次，系统最低要求 9 次)
#    覆盖连续 3 天早中晚 9 次打卡。
#    系统要求 PhotoStorage/ 目录下的总底图数量必须达到: 冷却池 + 8 张 (默认至少 17 张)。
PHOTO_COOLDOWN_COUNT=9

# e. 上传图片最大体积限制 (单位: KB，默认 1024 即 1MB)
MAX_PHOTO_SIZE_KB=1024

# f. 定时任务调用的 Python 解释器绝对路径 (运行初始化向导时会自动填入当前环境)
PYTHON_BIN=

# ==============================================================================
# 系统高级配置 (通常无需修改，保持默认即可)
# ==============================================================================
HQ_LATITUDE=34.802958
HQ_LONGITUDE=113.544171
ACCURACY_MIN=35
ACCURACY_MAX=65
BASE_URL=https://www.kassing.cn
